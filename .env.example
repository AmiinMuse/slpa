# Postgres connection string (Netlify Database, backed by Neon).
# Copy this file to .env.local and fill it in. Never commit .env.local.
# Setup steps: docs/MEMBERSHIP-FORM.md section 6.

# If Netlify offers both a pooled and a direct connection string, prefer the pooled
# one — each API route invocation opens its own connection, and a pooler (pgbouncer)
# in front of the database is what keeps that from exhausting its connection limit.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
