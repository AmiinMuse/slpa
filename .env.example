# Google Apps Script Web App that appends registrations to the SLPA sheet.
# Copy this file to .env.local and fill both values in. Never commit .env.local.
# Setup steps: docs/MEMBERSHIP-FORM.md section 6.

# The "/exec" URL from Deploy -> New deployment -> Web app.
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"

# A long random string. Must match the TOKEN constant in scripts/apps-script/Code.gs.
APPS_SCRIPT_TOKEN="change-me-to-a-long-random-string"
